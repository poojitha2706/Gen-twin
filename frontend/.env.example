# sample = built-in deterministic demo data, no backend needed
# api    = talk to a backend with login and /events (not the Render deployment)
# render = read the deployed GenTwin backend (no login): set VITE_API_URL to its address
VITE_DATA_SOURCE=sample
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
